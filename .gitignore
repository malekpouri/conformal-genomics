# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── Model checkpoints & large binaries (release via HF/Zenodo, not git) ───
*.pt
*.ckpt
*.safetensors
*.pkl
*.pkl.zip

# ── Data caches & references (not versioned) ─────────────────────────────
data/raw/
*.npy
*.npz
*.fa
*.fa.gz
*.fna
*.fna.gz

# ── Generated artefacts (regenerated by the pipeline) ────────────────────
results/plots/*.png
results/plots/*.pdf
results/*.log

# keep small machine-readable metric summaries
!results/json/*.json
!results/csv/*.csv

# ── LaTeX build intermediates (manuscript.pdf is kept) ───────────────────
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ── OS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.joblib

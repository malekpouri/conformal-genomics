  "E_structural_feasibility_bound": {
    "rule": "conformal p-values are bounded below by 1/(n_cal+1); BH rejects the k-th smallest only if p_(k) <= q*k/m, so a non-empty selection needs at least k_min = ceil(m/(q*(n_cal+1))) candidates AT the minimal p-value",
    "implies": "to certify a single candidate (k=1): n_cal >= m/q - 1",
